NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
# Orígenes permitidos separados por comas (agrega la IP de tu red para acceso desde celular)
CORS_ORIGIN=http://localhost:5173,http://192.168.1.11:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bundle_system
DB_CONNECTION_LIMIT=10

JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
JWT_EXPIRES_IN=8h

# HTTPS opcional: si defines ambas rutas el servidor levanta HTTPS en vez de HTTP.
# En producción se recomienda terminar TLS en un proxy (nginx/Caddy) con certificado real.
#HTTPS_KEY_PATH=certs/key.pem
#HTTPS_CERT_PATH=certs/cert.pem
